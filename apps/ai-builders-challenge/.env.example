# Copy to .env. Set at least one of ANTHROPIC_API_KEY or LLM_PROXY_URL
# before running `pytest` or hitting /chat, or the app will respond with
# a stub that echoes the retrieved context.

# Direct Anthropic API (recommended for offline challenge runs)
ANTHROPIC_API_KEY=

# Proxy mode — if you already run the portfolio's shared/api on port 3004,
# you can route through it instead. Must implement POST {system,user} -> {text}.
# LLM_PROXY_URL=http://localhost:3004/api/v1/ai-analysis/borrower-chat

# App port. Default 5100.
PORT=5100
