{
  "name": "@proto-portal/design-tokens",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared design tokens for Proto Portal Showcase Hub",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./css/*": "./css/*"
  },
  "files": [
    "dist/**/*",
    "css/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "tailwind",
    "css-variables"
  ]
}
